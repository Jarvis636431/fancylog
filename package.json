{
  "name": "fancylog",
  "version": "1.0.0",
  "description": "Stylized console logging helpers for browser dev easter eggs",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "console",
    "log",
    "style",
    "browser",
    "easter-egg"
  ],
  "author": "",
  "license": "ISC",
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@10.14.0",
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
